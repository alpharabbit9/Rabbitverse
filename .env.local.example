# Copy this file to `.env.local` and fill in the values, then restart `npm run dev`.
# Without these, Rabbit Verse runs in demo mode on sample data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo mode — sample data, no auth, no database. LOCAL DEVELOPMENT ONLY:
# it is ignored in a production build, where a signed-out visitor must reach
# /login rather than a dashboard of sample data. Leave unset for normal use;
# with no Supabase keys above, demo mode turns itself on anyway.
# NEXT_PUBLIC_DEMO_MODE=true
#
# (ALLOWED_EMAIL is gone as of V3.0 — Rabbit Verse is multi-user and self-serve.
#  Access is controlled by public.users.status, not by a single address.)

# Optional: canonical URL used for the OAuth redirect in production
# NEXT_PUBLIC_SITE_URL=https://rabbit-verse.vercel.app

# Reminders (Web Push) — the VAPID *public* key only. Generate a keypair with
# `npx web-push generate-vapid-keys`; the private key goes in the Edge Function
# secrets (see SUPABASE_SETUP.md), never here. Without this, the reminders
# toggle shows "not configured".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# AI natural-language logging (V2) — server-side Groq key for parsing your
# "type what I did" sentence into log entries, AND for the voice input (Phase D),
# which transcribes a recording with Whisper before you review it. Get a free key
# at https://console.groq.com/keys. Without it the AI box still works, but falls
# back to a simple offline preview parser and the mic button is hidden (the manual
# Quick-Add forms are untouched either way). Models are set in src/lib/ai/groq.ts
# — check the key's available models at https://api.groq.com/openai/v1/models,
# since Groq retires older ones (llama-3.3-70b-versatile is already gone).
GROQ_API_KEY=

# Redis guardrails (V3.0 Phase E) — protect the SHARED Groq key once signup is
# open: per-user rate limits on parsing/transcription, a global daily circuit
# breaker, and idempotency on saves. Upstash Redis (REST, free tier) →
# https://console.upstash.com → create a database → "REST API". OPTIONAL: with
# these unset, every guardrail no-ops (allows) and the AI box behaves exactly as
# before — but set them before opening public signup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: max Groq calls per UTC day across ALL users (the circuit breaker).
# Defaults to 5000 if unset. A parse costs 1; a transcription costs more.
# GROQ_DAILY_LIMIT=5000
