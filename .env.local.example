# Copy this file to `.env.local` and fill in the values, then restart `npm run dev`.
# Without these, Rabbit Verse runs in demo mode on sample data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo mode — sample data, no auth, no database. LOCAL DEVELOPMENT ONLY:
# it is ignored in a production build, where a signed-out visitor must reach
# /login rather than a dashboard of sample data. Leave unset for normal use;
# with no Supabase keys above, demo mode turns itself on anyway.
# NEXT_PUBLIC_DEMO_MODE=true
#
# (ALLOWED_EMAIL is gone as of V3.0 — Rabbit Verse is multi-user and self-serve.
#  Access is controlled by public.users.status, not by a single address.)

# Optional: canonical URL used for the OAuth redirect in production
# NEXT_PUBLIC_SITE_URL=https://rabbit-verse.vercel.app

# Reminders (Web Push) — the VAPID *public* key only. Generate a keypair with
# `npx web-push generate-vapid-keys`; the private key goes in the Edge Function
# secrets (see SUPABASE_SETUP.md), never here. Without this, the reminders
# toggle shows "not configured".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# AI natural-language logging (V2) — server-side Groq key for parsing your
# "type what I did" sentence into log entries. Get a free key at
# https://console.groq.com/keys. Without it the AI box still works, but falls
# back to a simple offline preview parser (and the manual Quick-Add forms are
# untouched either way). Model is set in src/lib/ai/groq.ts — check the key's
# available models at https://api.groq.com/openai/v1/models, since Groq retires
# older ones (llama-3.3-70b-versatile is already gone).
GROQ_API_KEY=
