# Copy this file to `.env.local` and fill in the values, then restart `npm run dev`.
# Without these, Rabbit Verse runs in demo mode on sample data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private allowlist — ONLY this Google account may sign in
ALLOWED_EMAIL=megatron7464@gmail.com

